# Copy this file to .env and fill in real values before deploying.
# Never commit the .env file.

# Flask session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Optional: override the SQLite database location
# DATABASE_PATH=

# Email notifications (Gmail: use an App Password)
# Leave empty in development - notifications then work in-app only.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
